{
    "tasks": [
        {
            "type": "process",
            "label": "Build ColdFlow OpenGL",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\graphics\\ColdFlowOpenGL.cpp",
                "-o",
                "${workspaceFolder}\\graphics\\ColdFlowOpenGL.exe",
                "-lglfw3",
                "-lopengl32",
                "-lglu32",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\graphics"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "none",
            "detail": "Build the ColdFlow OpenGL visualization"
        },
        {
            "type": "process",
            "label": "Build and run ColdFlow OpenGL",
            "command": "${workspaceFolder}\\graphics\\ColdFlowOpenGL.exe",
            "options": {
                "cwd": "${workspaceFolder}\\graphics"
            },
            "dependsOn": "Build ColdFlow OpenGL",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the visualization and launch it"
        }
    ],
    "version": "2.0.0"
}